{
  "name": "gfit",
  "version": "0.1.0",
  "private": true,
  "description": "GFIT — coaching-session confirmation SaaS (pnpm monorepo)",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "24.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.26.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:reset": "supabase db reset --local --last 0 --no-seed",
    "db:migrate": "supabase migration up --local",
    "db:seed": "supabase db query --local --file supabase/seed.sql",
    "db:health": "supabase db query --local \"select 1 as healthy\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "supabase": "2.118.0",
    "typescript": "^7.0.2"
  }
}
