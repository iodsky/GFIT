{
  "name": "gfit",
  "version": "0.1.0",
  "private": true,
  "description": "GFIT — coaching-session confirmation SaaS (pnpm monorepo)",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.26.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.13",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
